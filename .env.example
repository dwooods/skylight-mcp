# Skylight MCP Server Configuration
# Copy this file to .env and fill in your values

# ============================================
# AUTHENTICATION
# ============================================
# Recommended: no variables. Run `node dist/index.js auth login` once instead.
# The credential is stored outside the repo (see README > Authentication).

# Deprecated fallback: email/password in the environment
# SKYLIGHT_EMAIL=your_email@example.com
# SKYLIGHT_PASSWORD=your_password_here

# Manual token (overrides the stored credential if set)
# SKYLIGHT_TOKEN=your_token_here
# SKYLIGHT_AUTH_TYPE=bearer

# ============================================
# REQUIRED
# ============================================

# Your Skylight frame (household) ID
# Found in API requests like /api/frames/{frameId}/chores
SKYLIGHT_FRAME_ID=your_frame_id_here

# ============================================
# OPTIONAL
# ============================================

# Default timezone for date operations
# Default: America/New_York
SKYLIGHT_TIMEZONE=America/New_York
