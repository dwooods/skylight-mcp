# Dependencies
node_modules/

# Build output
dist/

# Environment files / credentials (only .env.example is tracked)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.crt

# Skylight tokens and local state (OAuth/refresh tokens)
skylight-state*
token-store*
credential*.json
pending-login.json
.skylight/

# Traffic captures (contain real tokens, emails, calendar IDs)
*.har
*.mitm
*.flow
captures/

# Generated API types: built from real traffic captures and can embed
# personal data. Not used at runtime. Keep local, never commit.
src/api/generated-types.ts

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Plan folder (local planning docs)
../plan/
.dev.vars
.wrangler/
