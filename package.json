{
  "name": "@davidwoods/skylight-mcp",
  "version": "1.8.0",
  "description": "Unofficial MCP server for Skylight Calendar: local (stdio) and hosted (Cloudflare Workers), with browser-paste OAuth sign-in and an encrypted credential store",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "skylight-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "generate:types": "openapi-typescript ../skylight-api/docs/openapi/openapi.yaml -o src/api/generated-types.ts",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "worker:deploy:local": "wrangler deploy -c wrangler.local.jsonc",
    "worker:setup": "node scripts/setup-worker.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && vitest run && npm run build",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "keywords": [
    "mcp",
    "skylight",
    "calendar",
    "model-context-protocol",
    "claude",
    "ai",
    "family",
    "chores"
  ],
  "author": "David Woods",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwooods/skylight-mcp.git"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "openapi-typescript": "^7.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "homepage": "https://github.com/dwooods/skylight-mcp#readme",
  "bugs": {
    "url": "https://github.com/dwooods/skylight-mcp/issues"
  }
}
