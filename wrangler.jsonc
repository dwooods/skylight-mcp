{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skylight-mcp",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "kv_namespaces": [
    // Create with: npx wrangler kv namespace create OAUTH_KV   (then paste the id here)
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  // The change counter (60 changes and 10 deletes per hour per frame). Without this
  // binding the Worker still runs but counts in memory, which limits nothing across requests.
  "durable_objects": {
    "bindings": [{ "name": "WRITE_LIMITER", "class_name": "WriteLimiter" }]
  },
  "migrations": [{ "tag": "v1-write-limiter", "new_sqlite_classes": ["WriteLimiter"] }],
  "vars": {
    "DEFAULT_TIMEZONE": "America/Los_Angeles"
  }
  // Set with `npx wrangler secret put <NAME>`, never in this file:
  //   SETUP_PASSPHRASE  12+ chars; required on the consent page to link an account
  //   WORKER_URL        exactly the public origin, e.g. https://skylight-mcp.<subdomain>.workers.dev
  //                     (tokens are bound to it; kept out of the repo so the URL isn't published)
}
