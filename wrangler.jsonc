{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skylight-mcp",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "kv_namespaces": [
    // Create with: npx wrangler kv namespace create OAUTH_KV   (then paste the id here)
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    // Must be exactly the public origin of this Worker; tokens are bound to it.
    "WORKER_URL": "https://skylight-mcp.REPLACE_WITH_ACCOUNT_SUBDOMAIN.workers.dev",
    "DEFAULT_TIMEZONE": "America/Los_Angeles"
  }
  // Secrets (never in this file): npx wrangler secret put SETUP_PASSPHRASE
}
